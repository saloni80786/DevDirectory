{
  "name": "devdirectory",
  "private": true,
  "version": "1.0.0",
  "description": "DevDirectory - engineering portal and project vault (React 18, React Router 6, Axios, Express)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "server": "npm --prefix server run dev",
    "dev:all": "concurrently -n web,api -c cyan,yellow \"npm run dev\" \"npm run server\"",
    "setup": "npm install && npm --prefix server install"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "lucide-react": "^0.453.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^9.0.1",
    "vite": "^5.4.10"
  }
}
